{
  "name": "@azrtydxb/kryton-init",
  "version": "0.2.0",
  "private": false,
  "description": "Interactive installer that signs in to a Kryton server, mints an API key, and wires every supported AI agent host (Claude Code, Cursor, Codex, OpenCode, Cline, Continue, KiloCode, RooCode, Claude Desktop) to use it",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "kryton-init": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test --enable-source-maps dist-test/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.6",
    "commander": "^14.0.0",
    "smol-toml": "^1.4.2",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azrtydxb/kryton.git",
    "directory": "packages/kryton-init"
  },
  "homepage": "https://github.com/azrtydxb/kryton#readme",
  "bugs": {
    "url": "https://github.com/azrtydxb/kryton/issues"
  }
}
