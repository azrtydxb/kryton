{
  "name": "@azrtydxb/server",
  "version": "4.6.5-pre.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node ../../scripts/fix-esm-imports.mjs",
    "start": "node dist/server.js",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:tsc": "tsc",
    "bench:attachments": "tsx scripts/bench/attachments.ts",
    "stress:yjs:converge": "tsx scripts/yjs-stress/two-client-convergence.ts",
    "stress:yjs:reconnect": "tsx scripts/yjs-stress/reconnect-storm.ts",
    "stress:yjs:rate": "tsx scripts/yjs-stress/op-rate-ceiling.ts",
    "openapi:dump": "tsx scripts/dump-openapi.ts",
    "openapi:check": "tsx scripts/dump-openapi.ts --check",
    "config:dump": "tsx scripts/dump-config-schema.ts",
    "config:check": "tsx scripts/dump-config-schema.ts --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.5.6",
    "@cedar-policy/cedar-wasm": "^4.10.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.1",
    "@fastify/websocket": "^11.0.1",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@opentelemetry/api": "^1.9.0",
    "@xenova/transformers": "^2.17.2",
    "better-auth": "^1.5.6",
    "chokidar": "^4.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^4.4.1",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^6.1.0",
    "lib0": "^0.2.99",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "ws": "^8.20.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.1.0",
    "fast-check": "^3.23.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.1"
  }
