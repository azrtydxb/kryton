# Kryton on Synology — .env template
#
# The real .env is generated by the SPK postinst script from the values you
# enter in the DSM install wizard. This file documents every variable for
# operator reference and recovery.
#
# Generated values you should NEVER edit by hand after install:
#   BETTER_AUTH_SECRET   random 48-char URL-safe token
#   POSTGRES_PASSWORD    random 48-char URL-safe token
#
# Wizard-provided values (re-run the install wizard to change them):
#   PKG_DATA_PATH        host directory holding notes/, data/, postgres/
#   PKG_HOST_PORT        port published on the NAS (default 3000)
#   ADMIN_EMAIL          initial admin user email
#   ADMIN_PASSWORD       initial admin user password
#   APP_URL              external URL Kryton advertises in links
#   BETTER_AUTH_URL      external URL the auth service uses for callbacks

PKG_DATA_PATH=/volume1/kryton
PKG_HOST_PORT=3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-during-install
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
APP_URL=http://0.0.0.0:3000
BETTER_AUTH_URL=http://0.0.0.0:3000
