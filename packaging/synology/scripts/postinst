#!/bin/sh
#
# Synology postinst — create data dirs, chown to runtime UID, write .env.
# Runs after package files are unpacked into ${SYNOPKG_PKGDEST}.

set -e

PKG_DIR="${SYNOPKG_PKGDEST:-/var/packages/kryton/target}"

: "${wizard_data_path:?wizard_data_path not set}"
: "${wizard_host_port:?wizard_host_port not set}"
: "${wizard_admin_email:?wizard_admin_email not set}"
: "${wizard_admin_password:?wizard_admin_password not set}"

# Match the canonical runtime UID/GID used elsewhere in the project.
RUN_UID=1001
RUN_GID=1001

mkdir -p \
  "$wizard_data_path/notes" \
  "$wizard_data_path/data" \
  "$wizard_data_path/postgres"

chown -R "${RUN_UID}:${RUN_GID}" "$wizard_data_path" || true
chmod -R u+rwX,g+rX "$wizard_data_path" || true

# Generate strong random secrets for the auth layer + postgres.
gen_secret() {
  # /dev/urandom → base64 → strip non-url-safe chars, take N bytes.
  head -c 48 /dev/urandom 2>/dev/null | base64 | tr -d '/+=\n' | cut -c1-48
}

BETTER_AUTH_SECRET="$(gen_secret)"
POSTGRES_PASSWORD="$(gen_secret)"

# Write .env consumed by docker-compose.yml. Quote values defensively.
ENV_FILE="$PKG_DIR/.env"
umask 077
cat > "$ENV_FILE" <<EOF
# Generated by Kryton SPK postinst. Do not edit manually — use DSM Package
# Center to reconfigure.
PKG_DATA_PATH=$wizard_data_path
PKG_HOST_PORT=$wizard_host_port
ADMIN_EMAIL=$wizard_admin_email
ADMIN_PASSWORD=$wizard_admin_password
BETTER_AUTH_SECRET=$BETTER_AUTH_SECRET
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
APP_URL=http://0.0.0.0:$wizard_host_port
BETTER_AUTH_URL=http://0.0.0.0:$wizard_host_port
EOF
chmod 0600 "$ENV_FILE"

exit 0
