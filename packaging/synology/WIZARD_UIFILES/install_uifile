[
  {
    "step_title": "Kryton — Storage & network",
    "items": [
      {
        "type": "textfield",
        "desc": "Data directory on the NAS (will hold notes, attachments, and the Postgres database).",
        "subitems": [
          {
            "key": "wizard_data_path",
            "desc": "Data path",
            "defaultValue": "/volume1/kryton"
          }
        ]
      },
      {
        "type": "textfield",
        "desc": "TCP port published on the NAS (1024-65535).",
        "subitems": [
          {
            "key": "wizard_host_port",
            "desc": "Host port",
            "defaultValue": "3000",
            "validator": {
              "fn": "function(v){v=parseInt(v,10);return !isNaN(v) && v>=1024 && v<=65535;}",
              "errorText": "Port must be a number between 1024 and 65535."
            }
          }
        ]
      }
    ]
  },
  {
    "step_title": "Kryton — Initial admin account",
    "items": [
      {
        "type": "textfield",
        "desc": "Email address for the initial admin user.",
        "subitems": [
          {
            "key": "wizard_admin_email",
            "desc": "Admin email",
            "validator": {
              "fn": "function(v){return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v);}",
              "errorText": "Enter a valid email address."
            }
          }
        ]
      },
      {
        "type": "password",
        "desc": "Initial admin password (minimum 12 characters).",
        "subitems": [
          {
            "key": "wizard_admin_password",
            "desc": "Password",
            "validator": {
              "fn": "function(v){return typeof v === 'string' && v.length >= 12;}",
              "errorText": "Password must be at least 12 characters."
            }
          },
          {
            "key": "wizard_admin_password_confirm",
            "desc": "Confirm password",
            "validator": {
              "fn": "function(v, all){return v === all.wizard_admin_password;}",
              "errorText": "Passwords do not match."
            }
          }
        ]
      }
    ]
  },
  {
    "step_title": "Kryton — License",
    "items": [
      {
        "type": "singleselect",
        "desc": "By installing Kryton you agree to the terms in the LICENSE file shipped with this package.",
        "subitems": [
          {
            "key": "wizard_accept_eula",
            "desc": "I accept the license terms.",
            "displayItems": [
              { "key": "true",  "desc": "Yes — install Kryton" },
              { "key": "false", "desc": "No — cancel" }
            ],
            "defaultValue": "false",
            "validator": {
              "fn": "function(v){return v === 'true';}",
              "errorText": "You must accept the license to install."
            }
          }
        ]
      }
    ]
  }
]
