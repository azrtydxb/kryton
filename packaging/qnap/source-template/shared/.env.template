# Kryton QPKG environment. Rendered by package_routines on first install with
# fresh random secrets. Operator edits here persist across upgrades because
# package_routines only writes .env when it is absent.

# ---------------------------------------------------------------------------
# Image — substituted at QPKG build time by packaging/qnap/build.sh.
# Pinned to a specific Kryton release tag so App Center upgrades pull a new
# image only when a new QPKG is installed.
# ---------------------------------------------------------------------------
KRYTON_IMAGE=${KRYTON_IMAGE}

# ---------------------------------------------------------------------------
# Host port. Default 3000. Change if 3000 is already in use on the NAS.
# ---------------------------------------------------------------------------
QPKG_HOST_PORT=3000

# ---------------------------------------------------------------------------
# Data root. Filled in by pkg_post_install. Must point at a directory on a
# QNAP volume the NAS user has write access to.
# ---------------------------------------------------------------------------
QPKG_DATA_DIR=__QPKG_DATA_DIR__

# ---------------------------------------------------------------------------
# Secrets. Generated by pkg_post_install on first install. To rotate, edit
# this file and run /etc/init.d/<qpkg>.sh restart.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
BETTER_AUTH_SECRET=__BETTER_AUTH_SECRET__

# ---------------------------------------------------------------------------
# Public URL. If you reverse-proxy Kryton behind HTTPS, set both of these to
# the public origin (e.g. https://kryton.lan.example.com).
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
